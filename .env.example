# ============================================================
# GameForge AI - Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env (já está no .gitignore).
# ============================================================

# --- Aplicação ---
ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Banco de dados ---
DATABASE_URL=sqlite+aiosqlite:///./workspace/gameforge.db

# --- Segurança (GERE VALORES ALEATÓRIOS FORTES EM PRODUÇÃO) ---
SECRET_KEY=troque-por-uma-chave-aleatoria-forte
SESSION_SECRET=troque-por-outra-chave-aleatoria-forte

# --- OAuth: Google ---
# Crie em https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth: GitHub ---
# Crie em https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- OAuth: Discord ---
# Crie em https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Planos ---
# E-mails que sempre recebem PRO automaticamente (separados por vírgula).
# Use isso para a SUA PRÓPRIA conta, configurado por você no servidor -
# nunca exponha isso como um código digitável no chat.
ADMIN_EMAILS=

# Quando true, libera todos os recursos PRO para qualquer usuário local
# (útil apenas para demonstração/desenvolvimento).
DEMO_UNLOCK_ALL_FEATURES=false

# --- Providers de IA ---
# demo = funciona 100% local sem custo, usando heurísticas (padrão)
# remote = usa a API da Anthropic (requer ANTHROPIC_API_KEY)
REASONING_PROVIDER=demo
ANTHROPIC_API_KEY=

IMAGE_PROVIDER=demo